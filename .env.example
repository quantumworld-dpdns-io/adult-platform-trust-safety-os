# ===========================================
# Adult Platform Trust & Safety OS
# Environment Configuration
# ===========================================

# --- Application ---
APP_NAME=adult-platform-trust-safety-os
APP_VERSION=1.0.0-alpha.1
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_LOG_LEVEL=INFO

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://trust_safety:dev_password_change_me@localhost:5432/trust_safety_dev
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5

# --- Qdrant Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=trust-safety-media
S3_REGION=us-east-1

# --- Ollama (Local AI) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI (Optional, for embeddings) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- JWT Authentication ---
JWT_ALGORITHM=ES256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# --- MFA ---
MFA_ISSUER_NAME=TrustSafetyOS
MFA_ISSUER_LABEL=Adult+Platform+Trust+Safety

# --- OAuth2 Providers ---
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_APPLE_CLIENT_ID=
OAUTH2_APPLE_CLIENT_SECRET=

# --- Encryption ---
ENCRYPTION_KEY=
VAULT_ADDR=
VAULT_TOKEN=

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=adult-platform-trust-safety-os
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Webhooks ---
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=30

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trust-safety.example.com

# --- AI Moderation ---
AI_CLASSIFICATION_THRESHOLD=0.85
AI_NSFW_THRESHOLD=0.90
AI_TOXICITY_THRESHOLD=0.80

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# --- Audit ---
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL=5

# --- Compliance ---
GDPR_DATA_RETENTION_DAYS=30
CCPA_OPT_OUT_ENABLED=true
COPPA_AGE_THRESHOLD=13
DSA_TRANSPARENCY_REPORTING=true

# --- Plugin System ---
PLUGIN_DIR=./plugins
PLUGIN_SANDBOX_ENABLED=true
PLUGIN_MAX_MEMORY_MB=256
PLUGIN_TIMEOUT_SECONDS=30

# --- Quantum Computing ---
QISKIT_BACKEND=aer_simulator
CUDAQ_ENABLED=false
PQC_ENABLED=true

# --- Federated Learning ---
FEDERATED_ROUND_TIMEOUT=300
FEDERATED_MIN_CLIENTS=3
FEDERATED_STRATEGY=fedavg

# --- Kubernetes / Deployment ---
KUBE_NAMESPACE=trust-safety
HELM_RELEASE=adult-platform-trust-safety
